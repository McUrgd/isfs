{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "isfs: build",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\build.ps1",
                "-Configuration",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "scripts\\build.ps1 -Configuration Debug: copies winfsp-x64.lib and winfsp-x64.dll from the installed WinFsp SDK, then compiles with cl.exe (found through vswhere when it is not on PATH). Output: isfs\\isfs.exe."
        },
        {
            "label": "isfs: build (W4/WX)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\build.ps1",
                "-Configuration",
                "Strict"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "scripts\\build.ps1 -Configuration Strict: strict compiler warnings (/W4 /WX). C4100 (unused WinFsp callback parameters) and warnings from the vendored WinFsp headers are suppressed. Output: isfs\\w4\\isfs.exe."
        },
        {
            "label": "isfs: analyze",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\build.ps1",
                "-Configuration",
                "Analyze"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "scripts\\build.ps1 -Configuration Analyze: MSVC static analysis (/analyze with /analyze:WX-, so analyzer findings are warnings). Slow; keep it separate from the default build. Output: isfs\\analyze\\isfs.exe."
        }
    ]
}
