{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "winfsp: copy runtime dll",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\copy-winfsp-dll.ps1",
                "-DestinationDir",
                "${workspaceFolder}\\isfs"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
        {
            "type": "cppbuild",
            "label": "isfs: build",
            "command": "cl.exe",
            "args": [
                "/nologo",
                "/Zi",
                "/MT",
                "/D_DEBUG",
                "/D_CONSOLE",
                "/DUNICODE",
                "/D_UNICODE",
                "/I${workspaceFolder}\\passthrough",
                "/I${workspaceFolder}",
                "/Fe${workspaceFolder}\\isfs\\isfs.exe",
                "/Fo${workspaceFolder}\\isfs\\",
                "/Fd${workspaceFolder}\\isfs\\",
                "${workspaceFolder}\\isfs\\isfs.c",
                "${workspaceFolder}\\cjson\\cJSON.c",
                "/link",
                "${workspaceFolder}\\passthrough\\lib\\winfsp-x64.lib",
                "advapi32.lib",
                "winhttp.lib"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": [
                "winfsp: copy runtime dll"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "WinFsp: passthrough\\winfsp (headers) + passthrough\\lib\\winfsp-x64.lib + winhttp.lib; JSON: cjson (cJSON.c); winfsp-x64.dll is copied next to the exe"
        }
    ]
}
